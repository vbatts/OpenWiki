<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.openwiki.app</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>OpenWiki</name>
  <summary>AI-powered knowledge capture and management</summary>

  <description>
    <p>
      OpenWiki is a desktop knowledge management tool that captures content from your
      clipboard and screenshots, then uses AI to organize, summarize, and connect
      everything into a personal wiki.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Automatic clipboard and screenshot capture</li>
      <li>AI-powered summaries and tagging</li>
      <li>Personal wiki with linked knowledge graph</li>
      <li>Weekly digest of captured content</li>
      <li>MCP server integration for Claude Desktop</li>
      <li>Export to Markdown</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.openwiki.app.desktop</launchable>

  <url type="homepage">https://github.com/kdsz001/OpenWiki</url>
  <url type="bugtracker">https://github.com/kdsz001/OpenWiki/issues</url>
  <url type="vcs-browser">https://github.com/kdsz001/OpenWiki</url>

  <developer id="com.openwiki">
    <name>OpenWiki</name>
  </developer>

  <categories>
    <category>Utility</category>
    <category>Office</category>
    <category>Documentation</category>
  </categories>

  <keywords>
    <keyword>knowledge</keyword>
    <keyword>wiki</keyword>
    <keyword>notes</keyword>
    <keyword>AI</keyword>
    <keyword>clipboard</keyword>
    <keyword>capture</keyword>
  </keywords>

  <!-- Replace with real screenshots before Flathub submission.
